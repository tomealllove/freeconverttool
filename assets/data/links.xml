<?xml version="1.0" encoding="UTF-8"?>
<!--
  首页底部「常用外链」配置
  说明：XML 注释中不能出现连续的短横线，请勿添加分隔线。
  · 位置：首页底部，最多显示 12 个（max 属性），超出部分忽略。
  · 每条外链用一个 <item> 表示：
      <name> 显示名称（留空则自动用域名）
      <url>  链接地址（必填；留空则该条不显示）
  · 想启用某条：把下面预留的空 <item> 填上 name 和 url 即可。
  · 想停用某条：把该条的 <url> 清空（或删除 <name>/<url> 内容）。
  · url 可省略协议，会自动补 https://（例如填 example.com）。
  · 修改后刷新页面即可生效（建议强制刷新 Ctrl+F5 清缓存）。
-->
<links max="12">
  <item>
    <name>中文资讯中心</name>
    <url>http://www.freeconvertbox.com/News/ch/1newslist.html</url>
  </item>
  <item>
    <name>Baidu</name>
    <url>https://www.baidu.com</url>
  </item>
  <item>
    <name>Bing</name>
    <url>https://www.bing.com</url>
  </item>

  <!-- 以下 9 个为预留位置，填写后自动显示 -->
